# Leave blank to use the instant built-in portfolio guide.
# If hosted separately, point to the Python service's HTTPS /chat endpoint.
PYTHON_CHAT_URL=
CHAT_BACKEND_TOKEN=

# NVIDIA NIM. With a key set, the Worker asks a model which approved answer
# fits the question and serves that answer's own prose; the model may only
# return an answer id and never writes portfolio text. Leave blank and the
# chatbot answers from the regex set alone.
#
# Not NEXT_PUBLIC_: this is a secret and is read on the server only.
# In production: wrangler secret put NIM_API_KEY --name portfolio-template
NIM_API_KEY=
# Defaults to openai/gpt-oss-20b, which answers in about a second. Most other
# models on integrate.api.nvidia.com are either not enabled for a given
# account or cold start past the 6s timeout, so confirm a replacement against
# your own key before setting this.
NIM_MODEL=

# Requests per visitor per minute on /api/chat, both in the Worker and in the
# Python service. Default 20 -- far above a human, far below what it takes to
# matter to a D1 write quota (every accepted request is one chat_health write).
#
# `npm run test:chat` replays 75 cases in a burst and WILL trip the default.
# Set this to 1000 in .env.local so the local dev server can serve the suite;
# leave it unset in production.
CHAT_RATE_LIMIT=

# ── Analytics ──────────────────────────────────────────────────────────────
# Set to 'true' to stop the browser recording anything. Only NEXT_PUBLIC_*
# vars reach the client bundle, so this is the one that can switch it off.
NEXT_PUBLIC_ANALYTICS_DISABLED=

# Required for ingest. Salts the visitor IP hash; the raw address is never
# stored. With this unset, /api/track refuses to write and says why in the
# log — an unsalted hash of the IPv4 space is trivially reversed.
ANALYTICS_IP_SALT=

# Comma-separated CIDRs whose sessions are marked internal, so your own
# visits can be filtered out of the panel. Prefixes broader than /16 (v4) or
# /32 (v6) are skipped with a warning: a stray /0 would mark every visitor
# internal and the panel would read as a traffic collapse rather than a typo.
ANALYTICS_INTERNAL_CIDRS=
# Comma-separated pfVisitorId values to treat as internal.
ANALYTICS_INTERNAL_VISITORS=

# ── Admin dashboard (/admin) ───────────────────────────────────────────────
# Comma-separated emails allowed in. Checked against a *verified* identity:
# a Google ID token when GOOGLE_CLIENT_ID is set, or the
# platform-injected oai-authenticated-user-email header when
# TRUST_PLATFORM_AUTH_HEADER is. With neither set it is inert and ADMIN_TOKEN
# is the only way in. Re-read on every request, so removing an address here
# ends that person's live session rather than waiting out its 12 hours.
ADMIN_EMAILS=

# Google OAuth *client id* for the /admin sign-in button. Not a secret — it is
# handed to the browser and shown to every visitor of /admin;
# what protects the gate is that Google signs a token naming this id as its
# audience, which nobody else can produce. There is no client secret: the
# sign-in uses Google Identity Services, which returns an ID token directly
# rather than an authorization code.
#
# Create one at console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application, with the site origin and
# http://localhost:3000 as Authorized JavaScript origins. Leave this unset and
# the button simply does not render; the token form still works.
#
# NOT prefixed NEXT_PUBLIC_ on purpose: that prefix is inlined at build time
# (in the server bundle too), so a runtime value on the Worker would never be
# read. It reaches the browser as a prop from the server component instead.
GOOGLE_CLIENT_ID=
# Fallback credential for local dev and curl, and the ONLY way in by default.
# Minimum 32 characters; a shorter value is not merely weak, it is ignored
# entirely — the gate skips the whole branch, so sign-in fails with no error.
ADMIN_TOKEN=

# Set to 1 ONLY on a host whose ingress strips inbound
# oai-authenticated-user-* headers (OpenAI Sites does; a plain Cloudflare
# Worker does not). Unset, ADMIN_EMAILS above is inert and the token is the
# only way in — which is the correct default.
#
# Setting this on a directly reachable origin hands the dashboard to anyone
# who sends an allowlisted email in a header, and this site prints the owner's
# address in its own contact section. See lib/analytics/admin-auth.ts.
TRUST_PLATFORM_AUTH_HEADER=
