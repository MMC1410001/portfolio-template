{
  "name": "portfolio-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "prebuild": "node scripts/sync-knowledge.mjs",
    "emit:migration": "node scripts/emit-migration.mjs",
    "typecheck": "tsc --noEmit",
    "test:chat": "node tests/chat.mjs",
    "check:model": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local --import ./tests/register-hooks.mjs scripts/check-model.mjs",
    "test:analytics": "node tests/analytics.mjs",
    "test:units": "node --experimental-strip-types --no-warnings --import ./tests/register-hooks.mjs --test \"tests/*.test.ts\"",
    "test": "npm run test:units && npm run test:py",
    "test:e2e": "npm run test:chat && npm run test:analytics",
    "seed:demo": "node --experimental-strip-types --no-warnings --import ./tests/register-hooks.mjs scripts/seed-analytics-demo.ts",
    "preflight": "node scripts/preflight-deploy.mjs",
    "deploy": "npm run typecheck && npm run test:units && npm run test:py && npm run preflight && npm run build && npm run db:migrate && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply ANALYTICS_DB --remote --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply ANALYTICS_DB --local --config wrangler.jsonc",
    "check:links": "node --experimental-strip-types --no-warnings --import ./tests/register-hooks.mjs scripts/check-links.mjs",
    "test:py": "node scripts/run-python-tests.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@cloudflare/workers-types": "5.20260928.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.142.0"
  },
  "type": "module"
}
